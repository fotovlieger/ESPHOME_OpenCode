# Copy to .env and fill in real values. .env is gitignored.
#
# GitHub personal access token used by git/gh inside the opencode container.
# Needs at least "repo" scope (or fine-grained: Contents + Metadata read/write).
GITHUB_TOKEN=ghp_replace_me

# Git identity used for commits made by the agent.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
