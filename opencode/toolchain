#!/usr/bin/env bash
# opencode `shell` wrapper.
#
# GitHub operations (git/gh) run locally in the opencode container, which is the
# only place credentials exist. Everything else is forwarded over SSH to the ESP
# toolchain host, so builds still see the real toolchain.
#
# opencode invokes this as: toolchain -c "<command>" with cwd set to the shared
# workspace, so the same absolute path exists locally and on the remote.

set -uo pipefail

is_github_cmd() {
  [[ "$1" =~ (^|[[:space:];&|()])git([[:space:]]|$) ]] || \
  [[ "$1" =~ (^|[[:space:];&|()])gh([[:space:]]|$) ]]
}

is_toolchain_cmd() {
  [[ "$1" =~ (^|[[:space:];&|()])(esphome|esptool|platformio|pio|idf\.py)([[:space:]]|$) ]]
}

if [ "${1:-}" = "-c" ]; then
  shift
  cmd="$*"
  if is_github_cmd "$cmd" && ! is_toolchain_cmd "$cmd"; then
    exec bash -c "$cmd"
  fi
  exec ssh -o LogLevel=ERROR toolchain "cd $(printf %q "$PWD") && $cmd"
fi

exec ssh -o LogLevel=ERROR -t toolchain "$@"
